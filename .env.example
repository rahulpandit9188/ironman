# Copy to .env on the EC2 host (never commit .env)

POSTGRES_DB=ironman_db
POSTGRES_USER=ironman_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_EC2_IP_OR_DOMAIN
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_IP_OR_DOMAIN,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_IP_OR_DOMAIN

# Images pushed by GitHub Actions CD
WEB_IMAGE=ghcr.io/YOUR_GITHUB_USER/ironman-web:latest
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_USER/studynotes-frontend:latest
